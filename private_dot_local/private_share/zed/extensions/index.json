{
  "extensions": {
    "html": {
      "manifest": {
        "id": "html",
        "name": "HTML",
        "version": "0.3.1",
        "schema_version": 1,
        "description": "HTML support.",
        "repository": "https://github.com/zed-industries/zed",
        "authors": [
          "Isaac Clayton <slightknack@gmail.com>"
        ],
        "lib": {
          "kind": "Rust",
          "version": "0.7.0"
        },
        "themes": [],
        "icon_themes": [],
        "languages": [
          "languages/html"
        ],
        "grammars": {
          "html": {
            "repository": "https://github.com/tree-sitter/tree-sitter-html",
            "rev": "bfa075d83c6b97cd48440b3829ab8d24a2319809",
            "path": null
          }
        },
        "language_servers": {
          "vscode-html-language-server": {
            "language": "HTML",
            "languages": [],
            "language_ids": {
              "CSS": "css",
              "HTML": "html"
            },
            "code_action_kinds": null
          }
        },
        "context_servers": {},
        "slash_commands": {},
        "snippets": null,
        "capabilities": []
      },
      "dev": false
    },
    "ini": {
      "manifest": {
        "id": "ini",
        "name": "ini",
        "version": "0.0.9",
        "schema_version": 1,
        "description": "Support for ini and ini like files (ini, conf, cfg) and systemd unit files (automount, mount, path, scope, service, slice, socket, swap, target, timer)",
        "repository": "https://github.com/bajrangCoder/zed-ini",
        "authors": [
          "Raunak Raj <bajrangcoders@gmail.com>"
        ],
        "lib": {
          "kind": null,
          "version": null
        },
        "themes": [],
        "icon_themes": [],
        "languages": [
          "languages/ini"
        ],
        "grammars": {
          "ini": {
            "repository": "https://github.com/justinmk/tree-sitter-ini",
            "rev": "e4018b5176132b4f3c5d6e61cea383f42288d0f5",
            "path": null
          }
        },
        "language_servers": {},
        "context_servers": {},
        "slash_commands": {},
        "snippets": null,
        "capabilities": []
      },
      "dev": false
    },
    "toml": {
      "manifest": {
        "id": "toml",
        "name": "TOML",
        "version": "1.0.3",
        "schema_version": 1,
        "description": "TOML support.",
        "repository": "https://github.com/zed-extensions/toml",
        "authors": [
          "Max Brunsfeld <max@zed.dev>",
          "Ammar Arif <evergreenkary@gmail.com>"
        ],
        "lib": {
          "kind": null,
          "version": null
        },
        "themes": [],
        "icon_themes": [],
        "languages": [
          "languages/toml"
        ],
        "grammars": {
          "toml": {
            "repository": "https://github.com/tree-sitter/tree-sitter-toml",
            "rev": "342d9be207c2dba869b9967124c679b5e6fd0ebe",
            "path": null
          }
        },
        "language_servers": {},
        "context_servers": {},
        "slash_commands": {},
        "snippets": null,
        "capabilities": []
      },
      "dev": false
    }
  },
  "themes": {},
  "icon_themes": {},
  "languages": {
    "HTML": {
      "extension": "html",
      "path": "languages/html",
      "matcher": {
        "path_suffixes": [
          "html",
          "htm",
          "shtml"
        ],
        "first_line_pattern": null,
        "modeline_aliases": []
      },
      "hidden": false,
      "grammar": "html"
    },
    "TOML": {
      "extension": "toml",
      "path": "languages/toml",
      "matcher": {
        "path_suffixes": [
          "Cargo.lock",
          "toml",
          "Pipfile",
          "uv.lock"
        ],
        "first_line_pattern": null,
        "modeline_aliases": []
      },
      "hidden": false,
      "grammar": "toml"
    },
    "ini": {
      "extension": "ini",
      "path": "languages/ini",
      "matcher": {
        "path_suffixes": [
          "ini",
          "inf",
          "conf",
          "cfg",
          "automount",
          "mount",
          "path",
          "scope",
          "service",
          "slice",
          "socket",
          "swap",
          "target",
          "timer",
          "container",
          "volume",
          "network",
          "kube",
          "image",
          "build",
          "pod"
        ],
        "first_line_pattern": null,
        "modeline_aliases": []
      },
      "hidden": false,
      "grammar": "ini"
    }
  }
}