  },
  "themes": {},
  "icon_themes": {},
  "languages": {
    "EmmyLuadoc": {
      "extension": "lua",
      "path": "languages/emmyluadoc",
      "matcher": {
        "path_suffixes": [],
        "first_line_pattern": null,
        "modeline_aliases": []
      },
      "hidden": true,
      "grammar": "emmyluadoc"
    },
    "Fish": {
      "extension": "fish",
      "path": "languages/fish",
      "matcher": {
        "path_suffixes": [
          "fish"
        ],
        "first_line_pattern": "^#!.*\\bfish\\b",
        "modeline_aliases": []
      },
      "hidden": false,
      "grammar": "fish"
    },
    "Ghostty": {
      "extension": "ghostty",
      "path": "languages/ghostty",
      "matcher": {
        "path_suffixes": [
          "ghostty/config",
          "com.mitchellh.ghostty/config",
          "config/ghostty/config",
          "ghostty"
        ],
        "first_line_pattern": "#\\s*(vim?:\\s*(set\\s+)?ft=ghostty|-\\*-\\s*(mode:\\s*)?ghostty\\s*-\\*-)",
        "modeline_aliases": []
      },
      "hidden": false,
      "grammar": "ghostty"
    },
    "HTML": {
      "extension": "html",
      "path": "languages/html",
      "matcher": {
        "path_suffixes": [
          "html",
          "htm",
          "shtml"
        ],
        "first_line_pattern": null,
        "modeline_aliases": []
      },
      "hidden": false,
      "grammar": "html"
    },
    "Lua": {
      "extension": "lua",
      "path": "languages/lua",
      "matcher": {
        "path_suffixes": [
          "lua"
        ],
        "first_line_pattern": null,
        "modeline_aliases": []
      },
      "hidden": false,
      "grammar": "lua"
    },
    "TOML": {
      "extension": "toml",
      "path": "languages/toml",
      "matcher": {
        "path_suffixes": [
          "Cargo.lock",
          "toml",
          "Pipfile",
          "uv.lock"
        ],
        "first_line_pattern": null,
        "modeline_aliases": []
      },
      "hidden": false,
      "grammar": "toml"
    },
    "ini": {
      "extension": "ini",
      "path": "languages/ini",
      "matcher": {
        "path_suffixes": [
          "ini",
          "inf",
          "conf",
          "cfg",
          "automount",
          "mount",
          "path",
          "scope",
          "service",
          "slice",
          "socket",
          "swap",
          "target",
          "timer",
          "container",
          "volume",
          "network",
          "kube",
          "image",
          "build",
          "pod"
        ],
        "first_line_pattern": null,
        "modeline_aliases": []
      },
      "hidden": false,
      "grammar": "ini"
    }
  }
}