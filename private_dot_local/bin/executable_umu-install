#!/usr/bin/env bash
set -euo pipefail

GAME_ROOT="$(realpath "$PWD")"
APPS_DIR="$HOME/.local/share/applications"
ICON_DIR="$HOME/.local/share/icons/hicolor/256x256/apps"

sanitize_path() {
    local p="${1#"${1%%[![:space:]]*}"}"
    p="${p%"${p##*[![:space:]]}"}"
    p="${p#[\'\"]}"
    p="${p%[\'\"]}"
    realpath "${p/#\~/$HOME}" 2>/dev/null || echo "$p"
}

extract_icon() {
    local exe="$1" out_png="$2"
    command -v wrestool >/dev/null 2>&1 && command -v icotool >/dev/null 2>&1 || return 1

    local tmp; tmp="$(mktemp -d)"
    trap 'rm -rf "$tmp"' RETURN

    wrestool -x -t 14 "$exe" -o "$tmp" 2>/dev/null || wrestool -x "$exe" -o "$tmp" 2>/dev/null || true
    icotool -x -o "$tmp" "$tmp"/*.ico 2>/dev/null || true

    local largest; largest="$(ls -S "$tmp"/*.png 2>/dev/null | head -n 1)"
    if [ -n "$largest" ] && [ -f "$largest" ]; then
        cp "$largest" "$out_png"
        cp "$largest" "$GAME_ROOT/icon.png" 2>/dev/null || true
        gtk-update-icon-cache -f -t "$HOME/.local/share/icons/hicolor" >/dev/null 2>&1 || true
        return 0
    fi
    return 1
}

EXE="${1:-}"
[ -z "$EXE" ] && read -e -p "Drag & drop game executable (.exe): " EXE
EXE="$(sanitize_path "$EXE")"
[ ! -f "$EXE" ] && { echo "[!] Executable not found: $EXE" >&2; exit 1; }

NAME="${2:-}"
EXE_BASENAME="$(basename "$EXE")"
[ -z "$NAME" ] && read -e -p "Game name [${EXE_BASENAME%.*}]: " NAME
NAME="${NAME:-${EXE_BASENAME%.*}}"

REL_EXE="$(realpath --relative-to="$GAME_ROOT" "$EXE")"
SLUG="$(echo "$NAME" | tr '[:upper:]' '[:lower:]' | tr ' ' '-' | tr -cd 'a-z0-9_-')"
[ -z "$SLUG" ] && SLUG="game_$(date +%s)"

mkdir -p "$GAME_ROOT/.wine" "$APPS_DIR" "$ICON_DIR"

RUN_SCRIPT="$GAME_ROOT/run.sh"
ICON_FILE="$ICON_DIR/${SLUG}.png"
ICON_ENTRY="Icon=wine"
extract_icon "$EXE" "$ICON_FILE" && ICON_ENTRY="Icon=${ICON_FILE}"

cat << EOF > "$RUN_SCRIPT"
#!/usr/bin/env bash
set -eo pipefail

DIR="\$(cd -- "\$(dirname -- "\${BASH_SOURCE[0]}")" &>/dev/null && pwd)"

# ==============================================================================
# CONFIGURATION & USER SETTINGS
# ==============================================================================

# Core Identity & Paths
export PROTONPATH="/usr/share/steam/compatibilitytools.d/proton-cachyos-native"
export GAME_NAME="${NAME}"
export GAME_EXE="\${DIR}/${REL_EXE}"
export WINEPREFIX="\${DIR}/.wine"
export STEAM_COMPAT_MOUNTS="/media/C"
DLL_OVERRIDES=""
GAME_ARGS=()

# OptiScaler Integration (Set to 1 to enable)
export PROTON_USE_OPTISCALER="0"
export PROTON_OPTISCALER_NAME="dxgi.dll"
export PROTON_OPTISCALER_CONFIG="Upscalers.Dx12Upscaler=fsr31;FrameGen.Enabled=true;FrameGen.FGInput=DLSSG;FrameGen.FGOutput=XeFG;FrameGen.FTInput=2;FSR.Fsr4Update=false"

# Proton & Upscaling Settings
export PROTON_VERB="run"
export SteamOS=1
export PROTON_USE_NTSYNC="1"
export PROTON_NO_WM_DECORATION="1"
export PROTON_FSR4_INDICATOR="0"
export PROTON_FSR4_UPGRADE="1"
export PROTON_XESS_UPGRADE="0"
export PROTON_DLSS_UPGRADE="0"
export PROTON_NO_STEAMINPUT="1"
export PROTON_PREFER_SDL="1"

# Graphics & Performance (Mesa / RADV)
export AMD_VULKAN_ICD="RADV"
export RADV_PERFTEST="sam"
export MESA_SHADER_CACHE_MAX_SIZE="12G"
export PROTON_LOCAL_SHADER_CACHE="1"
export RADV_TEX_ANISO="16"
export RADV_ANTI_LAG="1"
export WINE_DISABLE_VULKAN_OPWR="1"
export DXVK_HUD="0"
export all_proxy=""

# Gamescope Configuration
export USE_GAMESCOPE="1"
export GS_RES="2560x1440"
export GS_REFRESH="165"
export GS_WINDOW_MODE="fullscreen" # fullscreen | borderless
export GS_VRR="1"

# HDR Configuration
export GS_HDR="1"
export GS_HDR_ITM="0"              # Inverse Tone Mapping (Auto-HDR for SDR games)
export GS_HDR_SDR_NITS="203"       # Standard SDR paper-white reference
export GS_HDR_TARGET_NITS="350"    # Tune to your monitor's peak HDR nits

# ==============================================================================
# EXECUTION PIPELINE
# ==============================================================================

# Parse DLL overrides if set
if [ -n "\$DLL_OVERRIDES" ]; then
    IFS=',' read -ra _list <<< "\$DLL_OVERRIDES"
    for d in "\${_list[@]}"; do
        d="\$(echo "\$d" | xargs)"
        [ -z "\$d" ] && continue
        [[ "\$d" != *"="* ]] && d="\${d%.dll}=n,b"
        export WINEDLLOVERRIDES="\${WINEDLLOVERRIDES:+\$WINEDLLOVERRIDES;}\$d"
    done
fi

# Assemble Execution Command
CMD=()
command -v game-performance >/dev/null 2>&1 && CMD+=("game-performance")

if [ "\$USE_GAMESCOPE" = "1" ]; then
    export PROTON_ENABLE_WAYLAND="0"
    export ENABLE_GAMESCOPE_WSI="1"
    export XDG_CURRENT_DESKTOP="gamescope"
    export MANGOHUD="0" # Gamescope uses mangoapp instead of host mangohud

    GS_ARGS=(
        "gamescope"
        "-W" "\${GS_RES%x*}" "-H" "\${GS_RES#*x}"
        "-w" "\${GS_RES%x*}" "-h" "\${GS_RES#*x}"
        "-r" "\$GS_REFRESH"
    )

    [ "\${GS_WINDOW_MODE,,}" = "fullscreen" ] && GS_ARGS+=("-f")
    [ "\${GS_WINDOW_MODE,,}" = "borderless" ] && GS_ARGS+=("-b")
    [ "\$GS_VRR" = "1" ] && GS_ARGS+=("--adaptive-sync")

    if [ "\$GS_HDR" = "1" ]; then
        export PROTON_ENABLE_HDR="1"
        export DXVK_HDR="1"
        export DXVK_CONFIG="dxgi.enableHDR=True"
        GS_ARGS+=("--hdr-enabled" "--hdr-sdr-content-nits" "\$GS_HDR_SDR_NITS")
        [ "\$GS_HDR_ITM" = "1" ] && GS_ARGS+=("--hdr-itm-enable" "--hdr-itm-target-nits" "\$GS_HDR_TARGET_NITS")
    fi

    # Pass mangoapp overlay into gamescope session
    command -v mangoapp >/dev/null 2>&1 && GS_ARGS+=("--mangoapp")

    CMD+=("\${GS_ARGS[@]}" "--")
else
    # Fallback when running without gamescope
    export PROTON_ENABLE_WAYLAND="1"
    export MANGOHUD="1"
fi

CMD+=("umu-run" "\$GAME_EXE")

# Switch to game binary directory
cd "\$(dirname "\$GAME_EXE")"

# Execute
exec "\${CMD[@]}" "\${GAME_ARGS[@]}" "\$@"
EOF

chmod +x "$RUN_SCRIPT"

cat << EOF > "$APPS_DIR/${SLUG}.desktop"
[Desktop Entry]
Type=Application
Name=${NAME}
Exec="${RUN_SCRIPT}"
${ICON_ENTRY}
Terminal=false
Categories=Game;
Path=${GAME_ROOT}
EOF

chmod +x "$APPS_DIR/${SLUG}.desktop"
command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$APPS_DIR" >/dev/null 2>&1 || true

echo "[✓] Configured '$NAME' in '$GAME_ROOT'"
