[Unit]
Description=Route-proxy (mixed SOCKS5 + HTTP) driven by proxy.pac
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/proxy.py --listen 127.0.0.1:10880 --pac %h/.config/proxy/proxy.pac
Restart=on-failure
RestartSec=2
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
